# Copy this file to .env and fill in your own values. Never commit .env.

# --- Supabase (pipeline + scheduled jobs only; the service key bypasses security rules) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (website; safe to expose, security rules limit what it can read) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Groq (pipeline only, never in the website) ---
GROQ_API_KEY=
# One setting to swap the model
GROQ_MODEL=openai/gpt-oss-120b
